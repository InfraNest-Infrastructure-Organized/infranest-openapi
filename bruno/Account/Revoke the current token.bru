meta {
  name: Revoke the current token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Deletes the token that authenticated this request, so it stops working immediately. Other tokens on your account are not affected.
}
