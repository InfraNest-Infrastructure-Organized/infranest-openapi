meta {
  name: List provider accounts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/provider-credentials
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Every connected cloud, DNS, registrar and certificate account, with its health and how many zones, domains, certificates and servers it holds.

  Scope: `cloud.read`
}
