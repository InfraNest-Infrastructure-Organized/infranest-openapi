meta {
  name: Get provider account health
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/provider-credentials/health
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  How many enabled provider accounts there are (`total`) and how many are currently degraded or down (`unhealthy`).

  Scope: `cloud.read`
}
