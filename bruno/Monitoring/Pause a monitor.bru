meta {
  name: Pause a monitor
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/monitoring-checks/:monitoringCheck_id/pause
  body: none
  auth: inherit
}

params:path {
  monitoringCheck_id: 
}

headers {
