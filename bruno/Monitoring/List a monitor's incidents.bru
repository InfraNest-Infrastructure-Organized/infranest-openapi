meta {
  name: List a monitor’s incidents
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/monitoring-checks/:monitoringCheck_id/incidents
  body: none
  auth: inherit
}

params:path {
  monitoringCheck_id: 
}

headers {
