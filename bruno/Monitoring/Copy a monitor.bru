meta {
  name: Copy a monitor
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/monitoring-checks/:monitoringCheck_id/clone
  body: none
  auth: inherit
}

params:path {
  monitoringCheck_id: 
}

headers {
  Accept: application/json
}

docs {
  Creates a copy named with “(copy)” appended, with the same settings but no history. The copy starts paused, and counts against your plan like any new monitor.

  Scope: `monitoring.write`
}
