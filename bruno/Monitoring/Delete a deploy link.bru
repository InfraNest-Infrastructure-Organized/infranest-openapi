meta {
  name: Delete a deploy link
  type: http
  seq: 51
}

delete {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/deploy-links/:deployLink_id
  body: none
  auth: inherit
}

params:path {
  deployLink_id: 
}

headers {
  Accept: application/json
}

docs {
  Removes the link, so its deploys no longer appear on that monitor, server or tag.

  Scope: `monitoring.write`
}
