meta {
  name: Update a monitor
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/monitoring-checks/:monitoringCheck_id
  body: json
  auth: inherit
}

params:path {
  monitoringCheck_id: 
}

headers {
  Accept: application/json
}

body:json {
  {
    "interval_seconds": 300
  }
}

docs {
  Changes only the fields you send; keys inside `settings` are merged rather than replaced. Refused when a new interval, check type or set of regions is beyond your plan.

  Scope: `monitoring.write`
}
