meta {
  name: Get what a deploy changed
  type: http
  seq: 55
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/deploy-events/:deployEvent_id/changes
  body: none
  auth: inherit
}

params:path {
  deployEvent_id: 
}

headers {
  Accept: application/json
}

docs {
  The commits and pull requests since the previous successful deploy to the same place, each pull request with its `author` and the `files` it touches (up to 50; `changed_files` is the full count). Returns `first: true` when there is no earlier deploy to compare with, and `unavailable: true` when GitHub could not say. `verification` says whether the deploy made its monitors worse, as in the deploy list.

  Scope: `monitoring.read`
}
