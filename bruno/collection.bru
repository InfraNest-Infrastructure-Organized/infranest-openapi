meta {
  name: InfraNest API
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  The public InfraNest API. Pick the InfraNest environment, set `token` (My account → Developer; a test token from your sandbox to start) and `organization_id`, and every request is ready to send. Docs: https://developers.infranest.io
}
