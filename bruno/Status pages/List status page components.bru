meta {
  name: List status page components
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/status-pages/:statusPage_id/components
  body: none
  auth: inherit
}

params:path {
  statusPage_id: 
}

headers {
  Accept: application/json
}

docs {
  The page’s components in display order, each with its group, linked monitor and uptime bars over the page’s history window. A component with no monitor has no bars.

  Scope: `monitoring.read`
}
