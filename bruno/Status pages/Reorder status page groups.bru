meta {
  name: Reorder status page groups
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/status-pages/:statusPage_id/component-groups/sort
  body: json
  auth: inherit
}

params:path {
  statusPage_id: 
}

headers {
  Accept: application/json
}

body:json {
  {
    "order": [
      2,
      1
    ]
  }
}

docs {
  Sets the display order from `order`, a list of group IDs. Every ID must belong to this page.

  Scope: `monitoring.write`
}
