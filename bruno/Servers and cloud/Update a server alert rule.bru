meta {
  name: Update a server alert rule
  type: http
  seq: 69
}

patch {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/cloud-servers/:cloudServer_id/alert-rules/:alertRule_id
  body: json
  auth: inherit
}

params:path {
  cloudServer_id: 
  alertRule_id: 
}

headers {
  Accept: application/json
}

body:json {
  {
    "threshold": 85
  }
}

docs {
  Changes the `operator`, `threshold`, `duration_minutes` or `is_active` of one of this server’s rules. Changing the operator or threshold clears any breach the rule was tracking; durations outside the allowed range, or shorter than your plan allows, are refused.

  Scope: `cloud.write`
}
