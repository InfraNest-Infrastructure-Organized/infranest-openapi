meta {
  name: List images available to a server
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/cloud-servers/:cloudServer_id/images
  body: none
  auth: inherit
}

params:path {
  cloudServer_id: 
}

headers {
  Accept: application/json
}

docs {
  The operating system images the cloud provider offers for this server, under `images`. Empty when the provider account’s access does not cover the catalogue; refused when the server has no linked provider account.

  Scope: `cloud.read`
}
