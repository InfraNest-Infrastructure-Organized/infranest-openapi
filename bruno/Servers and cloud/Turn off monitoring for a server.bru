meta {
  name: Turn off monitoring for a server
  type: http
  seq: 42
}

delete {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/cloud-servers/:cloudServer_id/monitoring
  body: none
  auth: inherit
}

params:path {
  cloudServer_id: 
}

headers {
  Accept: application/json
}

docs {
  Stops monitoring the server and frees its place in your plan’s monitored-server count. The server itself is not affected.

  Scope: `cloud.write`
}
