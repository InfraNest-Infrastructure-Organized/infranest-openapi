meta {
  name: Get the latest monitoring agent release
  type: http
  seq: 43
}

get {
  url: {{baseUrl}}/api/organizations/{{organization_id}}/cloud-servers/:cloudServer_id/agent-release
  body: none
  auth: inherit
}

params:path {
  cloudServer_id: 
}

headers {
  Accept: application/json
}

docs {
  The current release of the InfraNest monitoring agent with its checksums, the install script URLs and the address the agent should report to. The answer is the same for every server.

  Scope: `cloud.read`
}
